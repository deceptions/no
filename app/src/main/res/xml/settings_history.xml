<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
>

    <PreferenceCategory android:title="Privacy">
    <SwitchPreference
            android:icon="@drawable/ic_baseline_screen_lock_landscape_24"
            android:key="incognito_mode"
            android:title="Incognito mode"
            android:summary="While on, Nekomo does not save watch progress, search history or sync progress to AniList/MAL."
            app:defaultValue="false"
    />
    <SwitchPreference
            android:icon="@drawable/ic_baseline_screen_lock_landscape_24"
            android:key="adult_lock"
            android:title="Lock 18+ content with my device lock"
            android:summary="Asks for your screen lock (PIN, pattern or fingerprint) before 18+ content can be switched on."
            app:defaultValue="false"
    />
    <Preference
            android:icon="@drawable/ic_baseline_vpn_lock_24"
            app:key="app_lock"
            android:title="Lock the app with a PIN"
            android:summary="Asks for your code every time the app starts"
    />
    <Preference
            android:icon="@drawable/ic_baseline_delete_outline_24"
            app:key="clear_search_history"
            android:title="Clear search history"
    />
    </PreferenceCategory>
    <PreferenceCategory android:title="Watch history and data">
    <SwitchPreference
            android:icon="@drawable/ic_baseline_history_24"
            android:key="save_history"
            android:title="Save and sync watch history"
            app:defaultValue="true"
    />
    <Preference
            android:icon="@drawable/ic_baseline_delete_outline_24"
            app:key="clear_history"
            android:title="Clear watch history"
    />
    <Preference
            android:icon="@drawable/ic_baseline_delete_outline_24"
            app:key="clear_cache"
            android:title="Clear image cache"
            android:summary="This will only free up storage, not fix any bugs"
    />
    <Preference
            android:icon="@drawable/ic_baseline_delete_outline_24"
            app:key="clear_network_cache"
            android:title="Clear network cache"
    />

    <Preference
            android:icon="@drawable/ic_baseline_bug_report_24"
            app:key="error_log_btt"
            android:title="Error log"
            android:summary="View, save or share crashes and errors that happened in the app"
    />

    <Preference
            android:title="Back up all data"
            app:key="backup_btt"
            android:icon="@drawable/ic_baseline_settings_backup_restore_24"
    />
    <Preference
            android:title="Restore all data"
            app:key="restore_btt"
            android:icon="@drawable/ic_baseline_settings_backup_restore_24"
    />

    </PreferenceCategory>
</PreferenceScreen>