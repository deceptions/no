<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          android:label="@string/app_name"
          tools:ignore="MissingLeanbackLauncher"
>
    <uses-sdk
            tools:overrideLibrary="androidx.leanback.tab, androidx.leanback.preference, androidx.leanback.paging"
    />

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-feature
            android:name="android.hardware.touchscreen"
            android:required="false"/>
    <uses-feature
            android:name="android.software.leanback"
            android:required="false"/>

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <queries>
        <!-- NEX companion app (detect whether it is installed so the Extensions manager can open it) -->
        <package android:name="net.nekomo.nex"/>
        <package android:name="net.nekomo.nex.debug"/>
    </queries>

    <application
            android:name=".AcraApplication"
            android:allowBackup="false"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize"
            tools:node="merge">

        <receiver android:name="com.lagradost.shiro.utils.NonCrashMediaButtonReceiver"
                  android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <activity android:name=".ui.player.PlayerActivity"
                  android:exported="true"
                  android:screenOrientation="userLandscape">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
        </activity>

        <service
                android:name=".services.VideoDownloadService"
                android:enabled="true"
                android:foregroundServiceType="dataSync"
                android:exported="false">
        </service>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.provider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/provider_paths"/>
        </provider>

        <activity android:name=".ui.ControllerActivity"/>
        <activity android:name=".ui.settings.SettingsActivity"
                  android:screenOrientation="behind"
                  android:theme="@style/preferenceActivityTheme"
                  android:fitsSystemWindows="true"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
        >

        </activity>
        <activity android:name=".ui.settings.ErrorLogActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:fitsSystemWindows="true"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
        >

        </activity>
        <activity android:name=".ui.settings.LicensesActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Open-source licenses"
        />
        <activity android:name=".ui.settings.AboutActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="About"
        />
        <activity android:name=".ui.settings.LegalPageActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Legal"
        />
        <activity android:name=".ui.settings.ExtensionManagerActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Extensions manager"
                  android:exported="true"
        >
            <!-- nekomo-repo://add?url=<repository url>: used by NEX (and anyone else) to hand a repository over.
                 It only opens the confirmation dialog; nothing is added or installed without the user's approval. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nekomo-repo" android:host="add"/>
                <data android:scheme="nekomo-repo" android:host="source"/>
                <data android:scheme="nekomo-repo" android:host="api"/>
            </intent-filter>
        </activity>
        <activity android:name=".ui.settings.CapturePrivacyActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Screen capture"
        />
        <activity android:name=".ui.settings.AppIdentityActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="App name and icon"
        />
        <activity android:name=".ui.settings.HomeSettingsActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Home page"
        />
        <activity android:name=".ui.settings.IntegrationsActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:fitsSystemWindows="true"
                  android:windowSoftInputMode="adjustResize"
                  android:label="Integrations"
        />
        <activity android:name=".ui.settings.TrackerLibraryActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:fitsSystemWindows="true"
        />
        <activity android:name=".ui.manga.MangaBrowseActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Manga"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
        />
        <activity android:name=".ui.manga.MangaDetailActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Manga"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
        />
        <activity android:name=".ui.manga.MangaReaderActivity"
                  android:theme="@style/Theme.AppCompat.NoActionBar"
                  android:label="Reader"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
        />
        <activity android:name=".ui.library.LocalLibraryActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:label="Offline library"
        />
        <activity android:name=".ui.settings.ExtensionsActivity"
                  android:theme="@style/preferenceActivityTheme"
                  android:fitsSystemWindows="true"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
                  android:label="Extensions"
        >

        </activity>
        <meta-data
                android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
                android:value="com.lagradost.shiro.utils.CastOptionsProvider"/>

        <receiver
                android:name=".receivers.VideoDownloadRestartReceiver"
                android:enabled="true"
                android:exported="true">
            <intent-filter>
                <action android:name="restart_service"/>
            </intent-filter>
        </receiver>
        <service
                android:name=".services.VideoDownloadKeepAliveService"
                android:enabled="true"
                android:foregroundServiceType="dataSync"
                android:exported="false">
        </service>
    </application>

</manifest>